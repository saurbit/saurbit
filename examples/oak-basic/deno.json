{
  "name": "@saurbit/example-oak-basic",
  "version": "0.0.0",
  "exports": "./main.ts",
  "tasks": {
    "check": "deno check **/*.ts",
    "dev": "deno run --allow-net --allow-env --watch main.ts",
    "dev:ca": "deno run --allow-net --allow-env --watch main_ca.ts",
    "start": "deno run --allow-net --allow-env main.ts",
    "start:client": "deno run --allow-net client.ts"
  },
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17.2.0",
    "jose": "npm:jose@^6.2.2"
  }
}
