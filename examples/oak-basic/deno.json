{
  "name": "@saurbit/example-oak-basic",
  "version": "0.0.0",
  "exports": "./main.ts",
  "tasks": {
    "check": "deno check **/*.ts",
    "dev": "deno run --allow-net --allow-env --watch main.ts",
    "dev:capk": "deno run --allow-net --allow-env --watch main_capk.ts",
    "dev:cas": "deno run --allow-net --allow-env --watch main_cas.ts",
    "start": "deno run --allow-net --allow-env main.ts",
    "start:client_capk": "deno run --allow-net client_capk.ts",
    "start:client_cas": "deno run --allow-net client_cas.ts"
  },
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17.2.0",
    "jose": "npm:jose@^6.2.10"
  }
}
