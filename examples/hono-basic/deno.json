{
  "name": "@saurbit/example-hono-basic",
  "version": "0.0.0",
  "exports": "./main.ts",
  "imports": {
    "@hono/standard-validator": "npm:@hono/standard-validator@^0.4.0",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.6.1",
    "arktype": "npm:arktype@^2.2.3",
    "hono": "npm:hono@^4",
    "hono-openapi": "npm:hono-openapi@^1.3.1",
    "hono/": "npm:/hono@^4/",
    "openapi-types": "npm:openapi-types@^12.1.3"
  },
  "tasks": {
    "check": "deno check **/*.ts",
    "dev": "deno run --allow-net --allow-env --watch main_oidc.ts",
    "dev:device": "deno run --allow-net --allow-env --watch main_device.ts",
    "dev:oidc": "deno run --allow-net --allow-env --watch main_oidc.ts",
    "start": "deno run --allow-net --allow-env main.ts"
  }
}
